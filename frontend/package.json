{
  "name": "nihon-ai-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "dev:lan": "next dev --turbopack -H 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:arch": "depcruise src --config .dependency-cruiser.cjs",
    "check": "npm run typecheck && npm run lint:arch && npm test"
  },
  "dependencies": {
    "next": "15.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.13",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "24.5.2",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "^5.2.0",
    "dependency-cruiser": "^18.2.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "4.1.13",
    "typescript": "5.9.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
