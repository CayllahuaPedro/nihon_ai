# Copy to .env and fill in. Never commit .env.

# Anthropic Claude API — level-aware tutor
ANTHROPIC_API_KEY=

# Backend
API_HOST=0.0.0.0
API_PORT=8000

# Vector store
CHROMA_PATH=.chroma

# Database
DATABASE_URL=sqlite:///./nihon_ai.db

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Point the tutor UI at the backend. Leave this unset and the frontend serves
# canned answers instead, and says so on screen rather than failing silently.
# frontend/.env.local:
#   NEXT_PUBLIC_TUTOR_API=http://localhost:8000
